{
  "schema": 1,
  "id": "core",
  "description": "Shared domain-neutral Termin Core SDK product closure.",
  "modules": [
    {
      "path": "termin-build-tools",
      "role": "build-tooling",
      "internal_dependencies": [],
      "native_targets": [],
      "python_distribution": "termin-build-tools"
    },
    {
      "path": "termin-nanobind-sdk",
      "role": "binding-runtime",
      "internal_dependencies": [],
      "native_targets": ["nanobind-ft"],
      "python_distribution": "termin-nanobind"
    },
    {
      "path": "termin-base",
      "role": "runtime",
      "internal_dependencies": ["termin-nanobind-sdk"],
      "native_targets": ["termin_base", "_tcbase_native", "_geom_native"],
      "python_distribution": "tcbase"
    },
    {
      "path": "termin-dispatch",
      "role": "runtime",
      "internal_dependencies": ["termin-base", "termin-nanobind-sdk"],
      "native_targets": ["termin_dispatch", "_dispatch_native"],
      "python_distribution": "termin-dispatch"
    },
    {
      "path": "termin-inspect",
      "role": "runtime",
      "internal_dependencies": ["termin-base", "termin-nanobind-sdk"],
      "native_targets": ["termin_inspect", "termin_inspect_python", "_inspect_native"],
      "python_distribution": "termin-inspect"
    },
    {
      "path": "termin-python-host",
      "role": "runtime",
      "internal_dependencies": [],
      "native_targets": ["termin_python_host", "termin_python"]
    },
    {
      "path": "termin-mcp",
      "role": "runtime",
      "internal_dependencies": ["termin-base"],
      "native_targets": [],
      "python_distribution": "termin-mcp"
    }
  ],
  "cmake_packages": [
    "termin",
    "termin_base",
    "termin_dispatch",
    "termin_inspect",
    "nanobind",
    "termin_python_host"
  ],
  "python_runtime": {
    "abi": "cp314t",
    "owner": "core",
    "inputs": [
      "build-system/python-runtime-core-lock.txt",
      "build-system/python-toolchain-lock.json",
      "build-system/python-sdk-build-requirements.txt"
    ]
  },
  "test_suites": [
    "termin-base-tests-native",
    "termin-base-tests-python",
    "termin-dispatch-tests-native",
    "termin-dispatch-tests-python",
    "termin-inspect-tests-native",
    "termin-inspect-tests",
    "termin-mcp-tests",
    "termin-nanobind-tests"
  ],
  "smoke_fixtures": [
    "tests/installed-core-consumers"
  ],
  "resources": [],
  "forbidden_dependency_roots": [
    "termin-app",
    "termin-assets",
    "termin-engine",
    "termin-graphics",
    "termin-image",
    "termin-mesh",
    "termin-physics",
    "termin-scene"
  ],
  "forbidden_artifact_markers": [
    "tgfx",
    "tmesh",
    "termin/image",
    "termin/scene",
    "termin/assets",
    "termin/engine",
    "termin_editor",
    "termin_launcher"
  ]
}
