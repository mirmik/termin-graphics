{
  "schema": 1,
  "description": "Termin Graphics repository test scheduling inventory.",
  "python_test_inventory": {
    "patterns": [
      "test_*.py",
      "*_test.py"
    ],
    "exclude_roots": [
      ".git",
      ".venv",
      "build",
      "sdk",
      "termin-thirdparty"
    ],
    "exclude_directory_names": [
      "__pycache__",
      "build",
      "dist"
    ]
  },
  "native_test_inventory": {
    "patterns": [
      "test_*",
      "tests_*",
      "*_test.*"
    ],
    "extensions": [
      ".c",
      ".cc",
      ".cpp",
      ".cxx"
    ],
    "exclude_roots": [
      ".git",
      "build",
      "sdk",
      "termin-thirdparty"
    ],
    "exclude_directory_names": [
      "__pycache__",
      "build",
      "dist"
    ],
    "source_classifications": [
