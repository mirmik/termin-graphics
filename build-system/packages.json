{
  "schema": 1,
  "description": "Termin Graphics SDK Python package manifest.",
  "packages": [
    {
      "path": "termin-build-tools",
      "distribution": "termin-build-tools",
      "source": "installed-core"
    },
    {
      "path": "termin-nanobind-sdk",
      "distribution": "termin-nanobind",
      "source": "installed-core"
    },
    {
      "path": "termin-base",
      "distribution": "tcbase",
      "source": "installed-core",
      "native_extensions": [
        {"extension": "tcbase._tcbase_native", "target": "_tcbase_native"},
        {"extension": "tcbase._geom_native", "target": "_geom_native"}
      ]
    },
    {
      "path": "termin-dispatch",
      "distribution": "termin-dispatch",
      "source": "installed-core",
      "native_extensions": [
        {"extension": "termin.dispatch._dispatch_native", "target": "_dispatch_native"}
      ]
    },
    {
      "path": "termin-inspect",
      "distribution": "termin-inspect",
      "source": "installed-core",
      "native_extensions": [
        {"extension": "termin.inspect._inspect_native", "target": "_inspect_native"}
      ]
    },
    {
      "path": "termin-mcp",
      "distribution": "termin-mcp",
      "source": "installed-core"
    },
    {
      "path": "termin-image",
      "distribution": "termin-image",
      "native_extensions": [
        {"extension": "termin.image._image_native", "target": "_image_native"}
      ]
    },
    {"path": "termin-tween", "distribution": "termin-tween"},
    {
      "path": "termin-mesh",
      "distribution": "tmesh",
      "native_extensions": [
        {"extension": "tmesh._tmesh_native", "target": "_tmesh_native"}
      ]
    },
    {
      "path": "termin-graphics",
      "distribution": "tgfx",
      "native_extensions": [
        {"extension": "tgfx._tgfx_native", "target": "_tgfx_native"}
      ]
    },
    {"path": "termin-graphics-mcp", "distribution": "termin-graphics-mcp"},
    {
      "path": "termin-visual-scene",
      "distribution": "termin-visual-scene",
      "native_extensions": [
        {"extension": "termin.visual_scene._visual_scene_native", "target": "_visual_scene_native"}
      ]
    },
    {
      "path": "termin-materials",
      "distribution": "termin-materials",
      "native_extensions": [
        {"extension": "termin.materials._materials_native", "target": "_materials_native"}
      ]
    },
    {"path": "termin-shader-runtime", "distribution": "termin-shader-runtime"},
    {
      "path": "termin-window",
      "distribution": "termin-window",
      "native_extensions": [
        {
          "extension": "termin.window._window_native",
          "target": "_window_native",
          "optional": true,
          "features": ["sdl"]
        }
      ]
    },
    {
      "path": "termin-gui-native",
      "distribution": "termin-gui-native",
      "native_extensions": [
        {"extension": "termin.gui_native._gui_native", "target": "_gui_native"},
        {
          "extension": "termin.gui_native._gui_native_window",
          "target": "_gui_native_window",
          "optional": true,
          "features": ["sdl"]
        }
      ]
    },
    {
      "path": "termin-nodegraph",
      "distribution": "termin-nodegraph",
      "native_extensions": [
        {"extension": "tcnodegraph._nodegraph_native", "target": "_nodegraph_native"}
      ]
    },
    {
      "path": "tcplot",
      "distribution": "tcplot",
      "native_extensions": [
        {"extension": "tcplot._tcplot_native", "target": "_tcplot_native"}
      ]
    },
    {
      "path": "tcplot-gui-native",
      "distribution": "tcplot-gui-native",
      "native_extensions": [
        {"extension": "tcplot_gui_native._tcplot_gui_native", "target": "_tcplot_gui_native"}
      ]
    },
    {
      "path": "termin-skeleton",
      "distribution": "termin-skeleton",
      "native_extensions": [
        {"extension": "termin.skeleton._skeleton_native", "target": "_skeleton_native"}
      ]
    },
    {
      "path": "termin-animation",
      "distribution": "termin-animation",
      "native_extensions": [
        {"extension": "termin.animation._animation_native", "target": "_animation_native"}
      ]
    },
    {
      "path": "termin-glb-native",
      "distribution": "termin-glb-native",
      "native_extensions": [
        {"extension": "termin.glb._glb_native", "target": "_glb_native"}
      ]
    },
    {"path": "termin-glb", "distribution": "termin-glb"}
  ]
}
