#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
SDK_ROOT="${SDK_PREFIX:-$REPO_ROOT/sdk}"
PYTHON_COMMAND="${PYTHON_BIN:-python3}"

PYTHONPATH="$REPO_ROOT/termin-build-tools" \
    "$PYTHON_COMMAND" -m termin_build.relocated_sdk_smoke --sdk-root "$SDK_ROOT"
